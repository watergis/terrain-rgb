{
  "name": "dem-tiles",
  "version": "3.1.0",
  "description": "Decode elevation from Terrain RGB and Terrarium raster tilesets by longitude and latitude. Fork of @watergis/terrain-rgb.",
  "homepage": "https://github.com/alrico88/dem-tiles#readme",
  "bugs": {
    "url": "https://github.com/alrico88/dem-tiles/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jin IGARASHI"
  },
  "contributors": [
    {
      "name": "alrico88"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrico88/dem-tiles.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/watergis/terrain-rgb"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "decoder": [
        "./dist/decoder.d.ts"
      ]
    }
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./decoder": {
      "import": {
        "types": "./dist/decoder.d.ts",
        "default": "./dist/decoder.js"
      },
      "require": {
        "types": "./dist/decoder.d.cts",
        "default": "./dist/decoder.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepare": "vp pack",
    "release": "changeset publish",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^2.27.12",
    "@jsquash/webp": "^1.5.0",
    "@mapbox/sphericalmercator": "^2.0.2",
    "@mapbox/tilebelt": "^2.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.13.1",
    "@types/png-chunks-encode": "^1.0.2",
    "@types/png-chunks-extract": "^1.0.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-png": "^8.0.0",
    "lefthook": "^1.10.10",
    "lru-cache": "^11.3.5",
    "p-memoize": "^8.0.0",
    "playwright": "^1.64.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "publint": "^0.3.4",
    "string-object-formatter": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@jsquash/webp": "^1.5.0",
    "fast-png": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@jsquash/webp": {
      "optional": true
    },
    "fast-png": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
